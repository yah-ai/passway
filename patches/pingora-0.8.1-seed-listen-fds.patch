+    /// Adopt an already-listening socket for the listener that will be added
+    /// with bind address `bind` (the exact string later passed to
+    /// `add_tcp` / `add_tls_with_settings`, e.g. `"0.0.0.0:443"`). Call before
+    /// [`Self::bootstrap`]. The server takes ownership of `fd`.
+    ///
+    /// This is how a pingora server runs under systemd socket activation or
+    /// any supervisor that holds the listening socket across restarts and
+    /// passes it as an inherited fd (`LISTEN_FDS`): the caller reads the
+    /// inherited fd number and seeds it here, and the matching listener then
+    /// accepts on it instead of binding a fresh socket. Fds received over the
+    /// upgrade socket (`Opt::upgrade`) take precedence for the same bind.
+    ///
+    /// ```ignore
+    /// // systemd passes the first socket as fd 3 with LISTEN_FDS=1.
+    /// if std::env::var("LISTEN_FDS").ok().as_deref() == Some("1") {
+    ///     server.seed_listen_fd("0.0.0.0:443", 3);
+    /// }
+    /// server.bootstrap();
+    /// ```
+    #[cfg(unix)]
+    pub fn seed_listen_fd(&mut self, bind: impl Into<String>, fd: std::os::unix::io::RawFd) {
+        self.bootstrap.lock().seed_fd(bind.into(), fd);
+    }
